# Source-only repository: unknown file types are ignored by default.
# Keep directories traversable so source files in studies remain discoverable.
*
!*/
!.gitignore
!.gitattributes
!.python-version
!.env.example
!*.py
!*.pyi
!*.sh
!*.bash
!*.ps1
!*.bat
!*.cmd
!*.c
!*.cc
!*.cpp
!*.h
!*.hpp
!*.cu
!*.cuh
!*.js
!*.mjs
!*.ts
!*.tsx
!*.jsx
!*.css
!*.md
!*.rst
!*.toml
!*.yaml
!*.yml
!*.ini
!*.cfg
!*.lock
!requirements*.txt
!Makefile
!Dockerfile
!LICENSE*
!NOTICE*

# JSON is normally generated output; retain source configuration and fixtures.
!/configs/**/*.json
!/tests/fixtures/**/*.json
!/studies/**/cohorts/**/*.json
!/studies/**/*policy.json
!/studies/correction_all_positions_grid/token_matched_plan.json

# Generated trees override the source extensions above (including copied code).
/data/
outputs/
wandb/
runs/
checkpoints/
figures/
/research/
artifacts/
results/
eval/
traces/
logs/
/configs/generated/
.code_backups/
.venv/
venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.triton/
torchinductor_*/
triton_cache/
inductor_cache/
htmlcov/
*.egg-info/
dist/
build/
.ipynb_checkpoints/
.idea/
.vscode/

# Local secrets must stay ignored even if their extension is allowlisted.
.env
.env.*
!.env.example
id_ed25519*
id_rsa*
*credentials*.json
*secret*.yaml
*secret*.yml

# Generated HTML embeds large result payloads; retain editable templates only.
!*template*.html
